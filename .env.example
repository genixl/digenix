# Public origin of the site (e.g. https://example.com), used for canonical links, share tags and the sitemap
NUXT_PUBLIC_SITE_URL=

# Neon PostgreSQL connection string (pooled), used by Nitro, drizzle-kit and the seed script
NUXT_DATABASE_URL=

# Secret used to sign session JWTs (at least 32 random characters)
NUXT_JWT_SECRET=

# Cloudinary credentials (server only)
NUXT_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=

# First admin_editor account created by `pnpm db:seed`
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
